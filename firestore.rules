rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================================================
       ETS AMANI — FIRESTORE SECURITY RULES

       RBAC
       + ISOLATION PAR AGENCE
       + DG FEATURE CONTROL
       + REGISTRATION WORKFLOW
       + DELEGATIONS

       ROLES OFFICIELS :
       - administrateur_systeme
       - directeur_general
       - administrateur_agence
       - agent
       - abonne
       - client
       ========================================================= */


    /* =========================================================
       AUTHENTIFICATION
       ========================================================= */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnUser(uid) {
      return isSignedIn()
        && request.auth.uid == uid;
    }


    /* =========================================================
       UTILISATEUR COURANT
       ========================================================= */

    function currentUserExists() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function currentUserData() {
      return currentUser().data;
    }


    /* =========================================================
       UTILISATEUR ACTIF
       ========================================================= */

    function isActiveUser() {
      return currentUserExists()
        && currentUserData().get('status', null) == 'active'
        && currentUserData().get('isApproved', false) == true;
    }


    /* =========================================================
       ROLES OFFICIELS
       ========================================================= */

    function isSystemAdmin() {
      return isActiveUser()
        && currentUserData().get('role', null) == 'administrateur_systeme';
    }

    function isDG() {
      return isActiveUser()
        && currentUserData().get('role', null) == 'directeur_general';
    }

    function isAdministrateurAgence() {
      return isActiveUser()
        && currentUserData().get('role', null) == 'administrateur_agence';
    }

    function isAgent() {
      return isActiveUser()
        && currentUserData().get('role', null) == 'agent';
    }

    function isAbonne() {
      return isActiveUser()
        && currentUserData().get('role', null) == 'abonne';
    }

    function isClient() {
      return isActiveUser()
        && currentUserData().get('role', null) == 'client';
    }


    /* =========================================================
       PERMISSIONS
       ========================================================= */

    function hasPermission(permission) {
      return isActiveUser()
        && (
          isSystemAdmin()
          ||
          isDG()
          ||
          (
            ('permissions' in currentUserData())
            &&
            (
              '*' in currentUserData().permissions
              ||
              permission in currentUserData().permissions
            )
          )
        );
    }


    /* =========================================================
       AGENCE COURANTE
       ========================================================= */

    function currentAgencyId() {
      return currentUserData().get('agencyId', null);
    }

    function belongsToAgency(agencyId) {
      return isActiveUser()
        && currentAgencyId() != null
        && currentAgencyId() == agencyId;
    }

    function isAgentInCurrentAgency() {
      return isAgent()
        && currentAgencyId() != null;
    }

    function hasAgentFunction(functionId) {
      return isAgentInCurrentAgency()
        &&
        (
          currentUserData().get('function', null) == functionId
          ||
          functionId in currentUserData().get('functions', [])
        );
    }


    /* =========================================================
       DIRECTEUR GENERAL OFFICIEL
       ========================================================= */

    function isCurrentDirectorGeneral() {
      return isDG()
        && exists(
          /databases/$(database)/documents/system/directorGeneral
        )
        && get(
          /databases/$(database)/documents/system/directorGeneral
        ).data.get('uid', null) == request.auth.uid
        && get(
          /databases/$(database)/documents/system/directorGeneral
        ).data.get('status', null) == 'active';
    }


    /* =========================================================
       FEATURE FLAGS GLOBAUX
       ========================================================= */

    function globalFeatureEnabled(featureId) {
      return exists(
        /databases/$(database)/documents/systemFeatures/$(featureId)
      )
      &&
      get(
        /databases/$(database)/documents/systemFeatures/$(featureId)
      ).data.get('enabled', false) == true;
    }


    /* =========================================================
       FEATURE FLAGS SPECIFIQUES AU DG
       ========================================================= */

    function dgFeatureEnabled(featureId) {
      return exists(
        /databases/$(database)/documents/system/directorGeneral/features/$(featureId)
      )
      &&
      get(
        /databases/$(database)/documents/system/directorGeneral/features/$(featureId)
      ).data.get('enabled', false) == true;
    }

    function canUseDGFeature(featureId, permission) {
      return isCurrentDirectorGeneral()
        && hasPermission(permission)
        && dgFeatureEnabled(featureId);
    }


    /* =========================================================
       DELEGATIONS
       ========================================================= */

    function hasDelegatedPermission(permission) {
      return isActiveUser()
        && exists(
          /databases/$(database)/documents/delegations/$(request.auth.uid)
        )
        &&
        get(
          /databases/$(database)/documents/delegations/$(request.auth.uid)
        ).data.get('status', 'inactive') == 'active'
        &&
        (
          !(
            'expiresAt'
            in get(
              /databases/$(database)/documents/delegations/$(request.auth.uid)
            ).data
          )
          ||
          get(
            /databases/$(database)/documents/delegations/$(request.auth.uid)
          ).data.expiresAt == null
          ||
          request.time <
          get(
            /databases/$(database)/documents/delegations/$(request.auth.uid)
          ).data.expiresAt
        )
        &&
        get(
          /databases/$(database)/documents/delegations/$(request.auth.uid)
        ).data.get('permissions', {}).get(permission, false) == true;
    }


    /* =========================================================
       VALIDATION DES INSCRIPTIONS
       ========================================================= */

    function canValidateRegistrations() {
      return isActiveUser()
        &&
        (
          isSystemAdmin()
          ||
          isCurrentDirectorGeneral()
          ||
          hasPermission('registrations.validate')
          ||
          hasDelegatedPermission('registrations.validate')
        );
    }


    /* =========================================================
       PERMISSIONS DELEGABLES
       ========================================================= */

    function isDelegablePermission(permission) {
      return permission in {
        'registrations.validate': true,
        'users.read': true,
        'reports.manage': true,
        'audit.read': true,
        'notifications.manage': true,
        'communication.manage': true,
        'billetage.access': true,
        'transactions.manage': true,
        'commissions.manage': true
      };
    }


    /* =========================================================
       VALIDATION D'UNE DEMANDE D'INSCRIPTION
       ========================================================= */

    function isPendingPublicRegistration(resourceData) {
      return resourceData.get('role', null) in [
        'client',
        'abonne'
      ]
      &&
      resourceData.get('status', null) in [
        'pending',
        'rejected'
      ]
      &&
      resourceData.get('isApproved', false) == false
      &&
      resourceData.get('registrationStatus', null) in [
        'pending',
        'under_review',
        'rejected'
      ];
    }

    function isPublicRegistrationRole(data) {
      return data.get('role', null) in [
        'client',
        'abonne'
      ];
    }

    function isRegistrationApproval(requestData, resourceData) {
      return requestData.get('status', null) == 'active'
        &&
        requestData.get('isApproved', false) == true
        &&
        requestData.get('registrationStatus', null) == 'approved'
        &&
        resourceData.get('status', null) in [
          'pending',
          'under_review'
        ]
        &&
        resourceData.get('isApproved', false) == false
        &&
        resourceData.get('registrationStatus', null) in [
          'pending',
          'under_review'
        ];
    }

    function isRegistrationRejection(requestData, resourceData) {
      return requestData.get('status', null) == 'rejected'
        &&
        requestData.get('isApproved', false) == false
        &&
        requestData.get('registrationStatus', null) == 'rejected'
        &&
        resourceData.get('status', null) in [
          'pending',
          'under_review'
        ]
        &&
        resourceData.get('isApproved', false) == false
        &&
        resourceData.get('registrationStatus', null) in [
          'pending',
          'under_review'
        ];
    }


    /* =========================================================
       USERS
       ========================================================= */

    match /users/{uid} {

      /* -------------------------------------------------------
         INSCRIPTION PUBLIQUE OU CREATION SYSTEME
         ------------------------------------------------------- */

      allow create: if
        (
          isOwnUser(uid)
          &&
          request.resource.data.uid == request.auth.uid
          &&
          request.resource.data.get('role', null) in [
            'client',
            'abonne'
          ]
          &&
          request.resource.data.get('status', null) == 'pending'
          &&
          request.resource.data.get('isApproved', false) == false
          &&
          request.resource.data.get('registrationStatus', null) == 'pending'
          &&
          ('permissions' in request.resource.data)
          &&
          request.resource.data.permissions.size() == 0
          &&
          (
            request.resource.data.get('role', null) == 'client'
            ||
            (
              request.resource.data.get('role', null) == 'abonne'
              &&
              request.resource.data.get('agencyId', null) != null
            )
          )
        )
        ||
        (
          isSystemAdmin()
          &&
          request.resource.data.uid == uid
          &&
          request.resource.data.get('role', null) == 'directeur_general'
          &&
          request.resource.data.get('category', null) == 'direction'
          &&
          request.resource.data.get('status', null) == 'active'
          &&
          request.resource.data.get('isApproved', false) == true
          &&
          request.resource.data.get('registrationStatus', null) == 'approved'
        );


      /* -------------------------------------------------------
         LECTURE
         ------------------------------------------------------- */

      allow read: if
        isOwnUser(uid)

        ||

        isSystemAdmin()

        ||

        isDG()

        ||

        (
          isAdministrateurAgence()
          && resource.data.get('agencyId', null)
             == currentAgencyId()
        )

        ||

        (
          hasPermission('users.read')
          &&
          (
            currentAgencyId() == null
            ||
            resource.data.get('agencyId', null)
               == currentAgencyId()
          )
        );


      /* -------------------------------------------------------
         MISE A JOUR DE SON PROPRE PROFIL (photoURL, displayName, phone)
         ------------------------------------------------------- */

      allow update: if
        isOwnUser(uid)
        &&
        request.resource.data.get('role', null) == resource.data.get('role', null)
        &&
        request.resource.data.get('status', null) == resource.data.get('status', null)
        &&
        request.resource.data.get('isApproved', false) == resource.data.get('isApproved', false)
        &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'photoURL',
            'displayName',
            'phone',
            'updatedAt'
          ]);

      /* -------------------------------------------------------
         MODIFICATION PAR ADMINISTRATEUR SYSTEME
         ------------------------------------------------------- */

      allow update: if
        isSystemAdmin();


      /* -------------------------------------------------------
         VALIDATION DES INSCRIPTIONS PAR DG
         ------------------------------------------------------- */

      allow update: if
        isCurrentDirectorGeneral()
        &&
        resource.data.get('role', null) != 'administrateur_systeme'
        &&
        request.resource.data.get('role', null) != 'administrateur_systeme'
        &&
        (
          (
            isRegistrationApproval(
              request.resource.data,
              resource.data
            )
            &&
            request.resource.data.uid == resource.data.uid
            &&
            request.resource.data.get('role', null)
              == resource.data.get('role', null)
            &&
            request.resource.data.get('requestedRole', null)
              == resource.data.get('requestedRole', null)
            &&
            request.resource.data.get('agencyId', null)
              == resource.data.get('agencyId', null)
            &&
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'isApproved',
                'registrationStatus',
                'approvedBy',
                'approvedAt',
                'reviewedBy',
                'reviewedAt',
                'updatedAt'
              ])
          )

          ||

          (
            isRegistrationRejection(
              request.resource.data,
              resource.data
            )
            &&
            request.resource.data.uid == resource.data.uid
            &&
            request.resource.data.get('role', null)
              == resource.data.get('role', null)
            &&
            request.resource.data.get('requestedRole', null)
              == resource.data.get('requestedRole', null)
            &&
            request.resource.data.get('agencyId', null)
              == resource.data.get('agencyId', null)
            &&
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'isApproved',
                'registrationStatus',
                'rejectionReason',
                'rejectedBy',
                'rejectedAt',
                'reviewedBy',
                'reviewedAt',
                'updatedAt'
              ])
          )

          ||

          (
            request.resource.data.get('registrationStatus', null) == 'under_review'
            &&
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'registrationStatus',
                'reviewedBy',
                'reviewedAt',
                'updatedAt'
              ])
          )

          ||

          (
            hasPermission('users.manage')
            &&
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'nom',
                'prenom',
                'email',
                'telephone',
                'role',
                'agentCategory',
                'agencyId',
                'agenceId',
                'agenceNom',
                'notes'
              ])
            &&
            request.resource.data.get('role', null)
              != 'administrateur_systeme'
          )
        );


      /* -------------------------------------------------------
         VALIDATION PAR ADMINISTRATEUR D'AGENCE
         ------------------------------------------------------- */

      allow update: if
        isAdministrateurAgence()
        &&
        hasPermission('users.manage')
        &&
        resource.data.get('role', null) != 'administrateur_systeme'
        &&
        resource.data.get('role', null) != 'directeur_general'
        &&
        request.resource.data.get('role', null) != 'administrateur_systeme'
        &&
        request.resource.data.get('role', null) != 'directeur_general'
        &&
        (
          (
            resource.data.get('role', null) == 'abonne'
            &&
            resource.data.get('agencyId', null)
              == currentAgencyId()
            &&
            request.resource.data.get('agencyId', null)
              == currentAgencyId()
            &&
            (
              (
                isRegistrationApproval(
                  request.resource.data,
                  resource.data
                )
                &&
                request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly([
                    'status',
                    'isApproved',
                    'registrationStatus',
                    'approvedBy',
                    'approvedAt',
                    'reviewedBy',
                    'reviewedAt',
                    'updatedAt'
                  ])
              )
              ||
              (
                isRegistrationRejection(
                  request.resource.data,
                  resource.data
                )
                &&
                request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly([
                    'status',
                    'isApproved',
                    'registrationStatus',
                    'rejectionReason',
                    'rejectedBy',
                    'rejectedAt',
                    'reviewedBy',
                    'reviewedAt',
                    'updatedAt'
                  ])
              )
            )
          )

          ||

          (
            resource.data.get('role', null) == 'client'
            &&
            (
              resource.data.get('agencyId', null) == null
              ||
              resource.data.get('agencyId', null)
                == currentAgencyId()
            )
            &&
            (
              request.resource.data.get('agencyId', null) == null
              ||
              request.resource.data.get('agencyId', null)
                == currentAgencyId()
            )
            &&
            (
              (
                isRegistrationApproval(
                  request.resource.data,
                  resource.data
                )
                &&
                request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly([
                    'status',
                    'isApproved',
                    'registrationStatus',
                    'approvedBy',
                    'approvedAt',
                    'reviewedBy',
                    'reviewedAt',
                    'updatedAt'
                  ])
              )
              ||
              (
                isRegistrationRejection(
                  request.resource.data,
                  resource.data
                )
                &&
                request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly([
                    'status',
                    'isApproved',
                    'registrationStatus',
                    'rejectionReason',
                    'rejectedBy',
                    'rejectedAt',
                    'reviewedBy',
                    'reviewedAt',
                    'updatedAt'
                  ])
              )
            )
          )
        );


      /* -------------------------------------------------------
         SUPPRESSION
         ------------------------------------------------------- */

      allow delete: if isSystemAdmin();
    }


    /* =========================================================
       REGISTRE DU DIRECTEUR GENERAL
       ========================================================= */

    match /system/directorGeneral {
      allow read: if isActiveUser();

      allow create, update, delete: if isSystemAdmin();
    }


    /* =========================================================
       FEATURE FLAGS DU DG
       ========================================================= */

    match /system/directorGeneral/features/{featureId} {

      allow read: if isActiveUser();

      allow create, update, delete: if isSystemAdmin();
    }

    match /system/directorGeneral/history/{historyId} {

      allow read: if isSystemAdmin() || isDG();

      allow create, update, delete: if isSystemAdmin();
    }

    match /systemControls/{controlId} {

      allow read: if isActiveUser();

      allow create, update, delete: if isSystemAdmin();
    }


    /* =========================================================
       FEATURE FLAGS GLOBAUX
       ========================================================= */

    match /systemFeatures/{featureId} {

      allow read: if isActiveUser();

      allow create, update, delete: if isSystemAdmin();
    }


    /* =========================================================
       CONFIGURATION SYSTEME
       ========================================================= */

    match /systemConfig/{configId} {

      allow read: if isActiveUser();

      allow create, update, delete: if isSystemAdmin();
    }


    /* =========================================================
       ANCIEN REGISTRE registrationRequests
       ========================================================= */

    match /registrationRequests/{requestId} {

      allow create: if
        isSignedIn()
        &&
        request.resource.data.uid == request.auth.uid
        &&
        request.resource.data.get('status', null) == 'pending'
        &&
        request.resource.data.get('requestedRole', null) in [
          'client',
          'abonne'
        ];

      allow read: if
        (
          isSignedIn()
          &&
          resource.data.uid == request.auth.uid
        )
        ||
        isSystemAdmin()
        ||
        isCurrentDirectorGeneral()
        ||
        (
          isAdministrateurAgence()
          &&
          (
            resource.data.get('agencyId', null) == null
            ||
            resource.data.get('agencyId', null)
              == currentAgencyId()
          )
        )
        ||
        hasDelegatedPermission('registrations.validate');

      allow update: if
        isSystemAdmin()
        ||
        (
          canValidateRegistrations()
          &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'reviewedBy',
              'reviewedAt',
              'reviewReason'
            ])
          &&
          request.resource.data.uid == resource.data.uid
          &&
          request.resource.data.get('requestedRole', null)
             == resource.data.get('requestedRole', null)
          &&
          request.resource.data.get('requestedCategory', null)
             == resource.data.get('requestedCategory', null)
        );

      allow delete: if isSystemAdmin();
    }


    /* =========================================================
       DELEGATIONS DG
       ========================================================= */

    match /delegations/{uid} {

      allow read: if
        isSystemAdmin()
        ||
        isCurrentDirectorGeneral()
        ||
        isOwnUser(uid);

      allow create, update: if
        isSystemAdmin()

        ||

        (
          isCurrentDirectorGeneral()
          &&
          request.resource.data.grantedBy == request.auth.uid
          &&
          request.resource.data.userId == uid
          &&
          exists(
            /databases/$(database)/documents/users/$(uid)
          )
          &&
          get(
            /databases/$(database)/documents/users/$(uid)
          ).data.get('status', null) == 'active'
          &&
          request.resource.data.get('status', null) == 'active'
          &&
          request.resource.data.get('permissions', {})
            .keys()
            .hasOnly([
              'registrations.validate',
              'users.read',
              'reports.manage',
              'audit.read',
              'notifications.manage',
              'communication.manage',
              'billetage.access',
              'transactions.manage',
              'commissions.manage'
            ])
        );

      allow delete: if
        isSystemAdmin()
        ||
        isCurrentDirectorGeneral();
    }


    /* =========================================================
       AGENCES
       ========================================================= */

    match /agencies/{agencyId} {

      allow read: if true;

      allow create: if
        isSystemAdmin()
        ||
        hasPermission('agencies.manage');

      allow update: if
        isSystemAdmin()
        ||
        hasPermission('agencies.manage');

      allow delete: if isSystemAdmin();
    }


    /* =========================================================
       TRANSACTIONS
       ========================================================= */

    match /transactions/{transactionId} {

      allow read: if

        isSystemAdmin()

        ||

        (
          isDG()
          &&
          hasPermission('transactions.manage')
          &&
          dgFeatureEnabled('transactions.manage')
        )

        ||

        (
          isAdministrateurAgence()
          &&
          hasPermission('transactions.manage')
          &&
          belongsToAgency(
            resource.data.get('agencyId', null)
          )
          &&
          globalFeatureEnabled('transactions.manage')
        )

        ||

        (
          hasPermission('transactions.manage')
          &&
          belongsToAgency(
            resource.data.get('agencyId', null)
          )
          &&
          globalFeatureEnabled('transactions.manage')
        );


      allow create: if

        isSystemAdmin()

        ||

        (
          isDG()
          &&
          hasPermission('transactions.manage')
          &&
          dgFeatureEnabled('transactions.manage')
          &&
          request.resource.data.get('agencyId', null) != null
        )

        ||

        (
          isAdministrateurAgence()
          &&
          hasPermission('transactions.manage')
          &&
          globalFeatureEnabled('transactions.manage')
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        )

        ||

        (
          hasPermission('transactions.manage')
          &&
          globalFeatureEnabled('transactions.manage')
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        );


      allow update: if

        isSystemAdmin()

        ||

        (
          isDG()
          &&
          hasPermission('transactions.manage')
          &&
          dgFeatureEnabled('transactions.manage')
          &&
          request.resource.data.get('agencyId', null)
             == resource.data.get('agencyId', null)
        )

        ||

        (
          isAdministrateurAgence()
          &&
          hasPermission('transactions.manage')
          &&
          globalFeatureEnabled('transactions.manage')
          &&
          resource.data.get('agencyId', null)
             == currentAgencyId()
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        )

        ||

        (
          hasPermission('transactions.manage')
          &&
          globalFeatureEnabled('transactions.manage')
          &&
          resource.data.get('agencyId', null)
             == currentAgencyId()
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        );


      allow delete: if isSystemAdmin();
    }


    /* =========================================================
       BILLETAGE
       ========================================================= */

    match /billetages/{billetageId} {

      allow read: if

        isSystemAdmin()

        ||

        (
          isDG()
          &&
          hasPermission('billetage.access')
          &&
          dgFeatureEnabled('billetage.access')
        )

        ||

        (
          isAdministrateurAgence()
          &&
          hasPermission('billetage.access')
          &&
          belongsToAgency(
            resource.data.get('agencyId', null)
          )
          &&
          globalFeatureEnabled('billetage.access')
        )

        ||

        (
          hasPermission('billetage.access')
          &&
          belongsToAgency(
            resource.data.get('agencyId', null)
          )
          &&
          globalFeatureEnabled('billetage.access')
        );


      allow create: if

        isSystemAdmin()

        ||

        (
          isDG()
          &&
          hasPermission('billetage.access')
          &&
          dgFeatureEnabled('billetage.access')
          &&
          request.resource.data.get('agencyId', null) != null
        )

        ||

        (
          isAdministrateurAgence()
          &&
          hasPermission('billetage.access')
          &&
          globalFeatureEnabled('billetage.access')
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        )

        ||

        (
          hasPermission('billetage.access')
          &&
          globalFeatureEnabled('billetage.access')
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        );


      allow update: if

        isSystemAdmin()

        ||

        (
          isDG()
          &&
          hasPermission('billetage.access')
          &&
          dgFeatureEnabled('billetage.access')
          &&
          request.resource.data.get('agencyId', null)
             == resource.data.get('agencyId', null)
        )

        ||

        (
          isAdministrateurAgence()
          &&
          hasPermission('billetage.access')
          &&
          globalFeatureEnabled('billetage.access')
          &&
          resource.data.get('agencyId', null)
             == currentAgencyId()
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        )

        ||

        (
          hasPermission('billetage.access')
          &&
          globalFeatureEnabled('billetage.access')
          &&
          resource.data.get('agencyId', null)
             == currentAgencyId()
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        );


      allow delete: if isSystemAdmin();
    }


    /* =========================================================
       RAPPORTS
       ========================================================= */

    match /reports/{reportId} {

      allow read: if

        isSystemAdmin()

        ||

        (
          isDG()
          &&
          hasPermission('reports.manage')
          &&
          dgFeatureEnabled('reports.manage')
        )

        ||

        (
          isAdministrateurAgence()
          &&
          hasPermission('reports.manage')
          &&
          belongsToAgency(
            resource.data.get('agencyId', null)
          )
          &&
          globalFeatureEnabled('reports.manage')
        )

        ||

        (
          hasPermission('reports.manage')
          &&
          belongsToAgency(
            resource.data.get('agencyId', null)
          )
          &&
          globalFeatureEnabled('reports.manage')
        );


      allow create: if

        isSystemAdmin()

        ||

        (
          isDG()
          &&
          hasPermission('reports.manage')
          &&
          dgFeatureEnabled('reports.manage')
          &&
          request.resource.data.get('agencyId', null) != null
        )

        ||

        (
          isAdministrateurAgence()
          &&
          hasPermission('reports.manage')
          &&
          globalFeatureEnabled('reports.manage')
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        )

        ||

        (
          hasPermission('reports.manage')
          &&
          globalFeatureEnabled('reports.manage')
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        );


      allow update: if

        isSystemAdmin()

        ||

        (
          isDG()
          &&
          hasPermission('reports.manage')
          &&
          dgFeatureEnabled('reports.manage')
          &&
          request.resource.data.get('agencyId', null)
             == resource.data.get('agencyId', null)
        )

        ||

        (
          isAdministrateurAgence()
          &&
          hasPermission('reports.manage')
          &&
          globalFeatureEnabled('reports.manage')
          &&
          resource.data.get('agencyId', null)
             == currentAgencyId()
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        )

        ||

        (
          hasPermission('reports.manage')
          &&
          globalFeatureEnabled('reports.manage')
          &&
          resource.data.get('agencyId', null)
             == currentAgencyId()
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        );


      allow delete: if isSystemAdmin();
    }


    /* =========================================================
       COMMISSIONS
       ========================================================= */

    match /commissions/{commissionId} {

      allow read: if

        isSystemAdmin()

        ||

        (
          isDG()
          &&
          hasPermission('commissions.manage')
          &&
          dgFeatureEnabled('commissions.manage')
        )

        ||

        (
          isAdministrateurAgence()
          &&
          hasPermission('commissions.manage')
          &&
          belongsToAgency(
            resource.data.get('agencyId', null)
          )
          &&
          globalFeatureEnabled('commissions.manage')
        )

        ||

        (
          hasPermission('commissions.manage')
          &&
          belongsToAgency(
            resource.data.get('agencyId', null)
          )
          &&
          globalFeatureEnabled('commissions.manage')
        );


      allow create: if

        isSystemAdmin()

        ||

        (
          isDG()
          &&
          hasPermission('commissions.manage')
          &&
          dgFeatureEnabled('commissions.manage')
          &&
          request.resource.data.get('agencyId', null) != null
        )

        ||

        (
          isAdministrateurAgence()
          &&
          hasPermission('commissions.manage')
          &&
          globalFeatureEnabled('commissions.manage')
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        )

        ||

        (
          hasPermission('commissions.manage')
          &&
          globalFeatureEnabled('commissions.manage')
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        );


      allow update: if

        isSystemAdmin()

        ||

        (
          isDG()
          &&
          hasPermission('commissions.manage')
          &&
          dgFeatureEnabled('commissions.manage')
          &&
          request.resource.data.get('agencyId', null)
             == resource.data.get('agencyId', null)
        )

        ||

        (
          isAdministrateurAgence()
          &&
          hasPermission('commissions.manage')
          &&
          globalFeatureEnabled('commissions.manage')
          &&
          resource.data.get('agencyId', null)
             == currentAgencyId()
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        )

        ||

        (
          hasPermission('commissions.manage')
          &&
          globalFeatureEnabled('commissions.manage')
          &&
          resource.data.get('agencyId', null)
             == currentAgencyId()
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()
        );


      allow delete: if isSystemAdmin();
    }


    /* =========================================================
       JOURNAL D'AUDIT
       ========================================================= */

    match /auditLogs/{logId} {

      allow read: if
        isSystemAdmin()
        ||
        hasPermission('audit.read');

      allow create: if isActiveUser();

      allow update, delete: if false;
    }


    /* =========================================================
       OPERATIONS & AFFECTATIONS D'OPERATIONS (SyncWorker)
       ========================================================= */

    match /operations/{operationId} {
      allow read: if isActiveUser();

      allow create, update: if
        isSystemAdmin()
        ||
        isDG()
        ||
        isAdministrateurAgence()
        ||
        isAgent();

      allow delete: if isSystemAdmin() || isDG();
    }

    match /operationAssignments/{assignmentId} {
      allow read: if isActiveUser();

      allow create, update: if
        isSystemAdmin()
        ||
        isDG()
        ||
        isAdministrateurAgence()
        ||
        isAgent();

      allow delete: if isSystemAdmin() || isDG();
    }


    /* =========================================================
       MESSAGES
       ========================================================= */

    match /messages/{messageId} {

      allow read, create: if isActiveUser();

      allow update: if isActiveUser();

      allow delete: if isSystemAdmin();
    }


    /* =========================================================
       NUMEROS INTERNES
       ========================================================= */

    match /internalNumbers/{numberId} {

      allow read: if isActiveUser();

      allow create, update, delete: if
        isSystemAdmin()
        ||
        (
          hasPermission('internal_numbers.manage')
          &&
          (
            isDG()
            ? dgFeatureEnabled('internal_numbers.manage')
            : globalFeatureEnabled('internal_numbers.manage')
          )
        );
    }


    /* =========================================================
       OPERATIONS SMS DES NUMEROS INTERNES
       ========================================================= */

    match /smsOperations/{operationId} {

      allow read: if

        isSystemAdmin()

        ||

        (
          isDG()
          &&
          hasPermission('transactions.manage')
          &&
          dgFeatureEnabled('transactions.manage')
        )

        ||

        (
          isAdministrateurAgence()
          &&
          hasPermission('transactions.manage')
          &&
          resource.data.get('agencyId', null)
             == currentAgencyId()
          &&
          globalFeatureEnabled('transactions.manage')
        );


      allow create: if

        isSystemAdmin()

        ||

        (
          isAgent()
          &&
          request.resource.data.get('agencyId', null)
             == currentAgencyId()

          &&

          request.resource.data.get('internalNumberId', null)
             != null

          &&

          exists(
            /databases/$(database)/documents/internalNumbers/$(request.resource.data.internalNumberId)
          )

          &&

          get(
            /databases/$(database)/documents/internalNumbers/$(request.resource.data.internalNumberId)
          ).data.get('assignedUserId', null)
             == request.auth.uid

          &&

          get(
            /databases/$(database)/documents/internalNumbers/$(request.resource.data.internalNumberId)
          ).data.get('agencyId', null)
             == currentAgencyId()

          &&

          get(
            /databases/$(database)/documents/internalNumbers/$(request.resource.data.internalNumberId)
          ).data.get('monitoringEnabled', false)
             == true

          &&

          request.resource.data.get('operator', null)
             ==
          get(
            /databases/$(database)/documents/internalNumbers/$(request.resource.data.internalNumberId)
          ).data.get('operator', null)
        );


      allow update: if

        isSystemAdmin()

        ||

        (
          isAgent()

          &&

          resource.data.get('agencyId', null)
             == currentAgencyId()

          &&

          resource.data.get('internalNumberId', null)
             != null

          &&

          exists(
            /databases/$(database)/documents/internalNumbers/$(resource.data.internalNumberId)
          )

          &&

          get(
            /databases/$(database)/documents/internalNumbers/$(resource.data.internalNumberId)
          ).data.get('assignedUserId', null)
             == request.auth.uid

          &&

          request.resource.data.get('internalNumberId', null)
             == resource.data.get('internalNumberId', null)

          &&

          request.resource.data.get('agencyId', null)
             == resource.data.get('agencyId', null)

          &&

          request.resource.data.get('operator', null)
             == resource.data.get('operator', null)
        );


      allow delete: if isSystemAdmin();
    }


    /* =========================================================
       NOTIFICATIONS
       ========================================================= */

    match /notifications/{notificationId} {

      allow read: if isActiveUser();

      allow create, update, delete: if
        isSystemAdmin()
        ||
        (
          hasPermission('notifications.manage')
          &&
          (
            isDG()
            ? dgFeatureEnabled('notifications.manage')
            : globalFeatureEnabled('notifications.manage')
          )
        );
    }


    /* =========================================================
       REGLEMENTS
       ========================================================= */

    match /regulations/{regulationId} {

      allow read: if isActiveUser();

      allow create, update, delete: if isSystemAdmin();
    }


    /* =========================================================
       ACCEPTATION DES REGLEMENTS
       ========================================================= */

    match /regulationAcceptances/{acceptanceId} {

      allow read: if
        (
          isSignedIn()
          &&
          resource.data.userId == request.auth.uid
        )
        ||
        isSystemAdmin();

      allow create: if
        isActiveUser()
        &&
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if isSystemAdmin();
    }


    /* =========================================================
       DENI PAR DEFAUT
       ========================================================= */

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
